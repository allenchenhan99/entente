{
  "name": "entente",
  "private": true,
  "version": "0.0.1",
  "description": "Entente — provenance engineering for coding agents: handoffs become confirmable, verifiable, retryable contracts; agents form a network with evidence and a way back",
  "license": "MIT",
  "type": "module",
  "bin": {
    "entente": "bin/entente.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node -e \"try{const fs=require('fs'),p=require('path'),d='node_modules/node-pty/prebuilds';for(const a of fs.readdirSync(d)){const f=p.join(d,a,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}}catch{}\""
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}

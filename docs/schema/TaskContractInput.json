{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^t-[a-z0-9-]+$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "runtime": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "goal": {
      "default": "",
      "type": "string"
    },
    "inputs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "default": {
        "allowed_paths": []
      },
      "type": "object",
      "properties": {
        "allowed_paths": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "allowed_paths"
      ],
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-\\d+$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "command"
                  },
                  "run": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeout_ms": {
                    "default": 120000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "kind",
                  "run",
                  "timeout_ms"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "diff_scope"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "file_exists"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "human_review"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "llm_judge"
                  },
                  "prompt": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "condition"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "default": {
        "type": "code_change",
        "evidence_required": []
      },
      "type": "object",
      "properties": {
        "type": {
          "default": "code_change",
          "type": "string",
          "enum": [
            "code_change"
          ]
        },
        "evidence_required": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "git_diff",
              "changed_files",
              "check_outputs"
            ]
          }
        }
      },
      "required": [
        "type",
        "evidence_required"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stagnation_limit": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_repairs",
        "stagnation_limit"
      ],
      "additionalProperties": false
    },
    "parent_task": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "recipient",
    "runtime",
    "goal",
    "inputs",
    "constraints",
    "non_goals",
    "scope",
    "acceptance_criteria",
    "output",
    "dependencies"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ids": {
      "default": [],
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
      }
    },
    "tags": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "max_bytes": {
      "default": 16384,
      "type": "integer",
      "minimum": 512,
      "maximum": 65536
    }
  },
  "required": [
    "ids",
    "tags",
    "max_bytes"
  ],
  "additionalProperties": false
}

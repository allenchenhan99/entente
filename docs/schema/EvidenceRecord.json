{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "git_diff_path": {
      "type": "string"
    },
    "changed_files": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^AC-\\d+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "pending_human",
              "error"
            ]
          },
          "output_path": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    },
    "self_report_mismatch": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-\\d+$"
      }
    }
  },
  "required": [
    "task_id",
    "contract_version",
    "attempt",
    "changed_files",
    "checks",
    "self_report_mismatch"
  ],
  "additionalProperties": false
}

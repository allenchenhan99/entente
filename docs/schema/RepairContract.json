{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "parent_task": {
      "type": "string"
    },
    "parent_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attempt": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "failed_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-\\d+$"
      }
    },
    "observed_failure": {
      "type": "string"
    },
    "requested_correction": {
      "type": "string"
    },
    "unchanged_scope": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_repairs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "parent_task",
    "parent_version",
    "attempt",
    "failed_criteria",
    "observed_failure",
    "requested_correction",
    "unchanged_scope",
    "remaining_repairs"
  ],
  "additionalProperties": false
}
